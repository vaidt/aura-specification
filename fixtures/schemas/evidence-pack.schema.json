{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AuraIDToken/aura-specification/fixtures/schemas/evidence-pack.schema.json",
  "title": "APS-300 Evidence Pack",
  "_status": "DRAFT TOP-LEVEL STRUCTURAL CONTRACT — semantic/profile closure remains governed by APS text and open decision records.",
  "description": "Draft machine-readable top-level contract for the canonical APS-300 Evidence Pack envelope.",
  "type": "object",
  "required": [
    "pack_id",
    "pack_version",
    "protocol_version",
    "schema_version",
    "evidence_profile",
    "requirement_references",
    "evidence_object",
    "evaluation_result",
    "policy_reference",
    "attestation",
    "integrity_metadata",
    "pack_hash"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_profile": {
      "type": "string",
      "enum": ["EPR-CORE", "EPR-AUDIT", "EPR-COMPLIANCE", "EPR-REL"]
    },
    "requirement_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_object": {
      "$ref": "evidence-object.schema.json"
    },
    "evaluation_result": {
      "$ref": "evaluation-result.schema.json"
    },
    "policy_reference": {
      "$ref": "policy-reference.schema.json"
    },
    "attestation": {
      "$ref": "attestation.schema.json"
    },
    "integrity_metadata": {
      "type": "object",
      "minProperties": 1,
      "description": "Pack-scoped integrity metadata. Exact component-hash vocabulary remains profile-bound."
    },
    "pack_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
