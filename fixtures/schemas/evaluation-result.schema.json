{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AuraIDToken/aura-specification/fixtures/schemas/evaluation-result.schema.json",
  "title": "APS-200 ENT-003 Evaluation Result",
  "_status": "DRAFT CONTRACT — top-level structure is closed and the current working profile AURA-DRAFT-CORE-001 result payload and decision vocabulary are closed; other future profiles remain version-bound.",
  "description": "Draft machine-readable contract for an Evaluation Result, including the current working-profile decision vocabulary and result payload.",
  "type": "object",
  "allOf": [
    { "$ref": "common-object-contract.schema.json" }
  ],
  "required": ["execution_id", "decision", "output_hash", "policy_reference", "result_fields"],
  "properties": {
    "object_type": { "const": "EvaluationResult" },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "MEASURE", "NOT_APPLICABLE"],
      "description": "Canonical decision token for the current working profile AURA-DRAFT-CORE-001."
    },
    "output_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_reference": {
      "$ref": "policy-reference.schema.json"
    },
    "result_fields": {
      "$ref": "#/$defs/current_profile_result_fields"
    }
  },
  "$defs": {
    "current_profile_result_fields": {
      "type": "object",
      "description": "Closed result payload for the current working profile AURA-DRAFT-CORE-001.",
      "required": [
        "profile_id",
        "subject_id",
        "measurement_value",
        "matched_policy_rule"
      ],
      "properties": {
        "profile_id": {
          "const": "AURA-DRAFT-CORE-001"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_value": {
          "type": "integer"
        },
        "matched_policy_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
